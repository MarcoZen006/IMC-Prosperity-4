import math
import json
from typing import Dict, List, Tuple
from datamodel import OrderDepth, TradingState, Order


class Trader:
    POSITION_LIMITS = {
        "HYDROGEL_PACK": 200,
        "VELVETFRUIT_EXTRACT": 200,
        "VEV_4000": 300,
        "VEV_4500": 300,
        "VEV_5000": 300,
        "VEV_5100": 300,
        "VEV_5200": 300,
        "VEV_5300": 300,
        "VEV_5400": 300,
        "VEV_5500": 300,
        "VEV_6000": 300,
        "VEV_6500": 300,
    }

    # This version deliberately keeps the +PnL Avellaneda-style logic from your
    # working bot, but makes it safer: position-limit clipping, traderData memory,
    # product-specific sizing, non-negative option quotes, and late inventory unwind.
    PRODUCT_PARAMS = {
        "HYDROGEL_PACK": {
            "alpha_vol": 0.08,
            "risk_aversion": 0.035,
            "base_spread": 1.8,
            "size": 18,
            "take_mult": 1.00,
            "max_var": 400.0,
        },
        "VELVETFRUIT_EXTRACT": {
            "alpha_vol": 0.08,
            "risk_aversion": 0.030,
            "base_spread": 1.8,
            "size": 16,
            "take_mult": 1.00,
            "max_var": 500.0,
        },
        "DEFAULT_VOUCHER": {
            "alpha_vol": 0.12,
            "risk_aversion": 0.045,
            "base_spread": 1.2,
            "size": 12,
            "take_mult": 1.10,
            "max_var": 200.0,
        },
    }

    def __init__(self):
        self.past_microprices: Dict[str, float] = {}
        self.volatility_ema: Dict[str, float] = {}

    def load_memory(self, trader_data: str) -> None:
        if not trader_data:
            return
        try:
            data = json.loads(trader_data)
            self.past_microprices = data.get("past_microprices", {})
            self.volatility_ema = data.get("volatility_ema", {})
        except Exception:
            self.past_microprices = {}
            self.volatility_ema = {}

    def save_memory(self) -> str:
        try:
            return json.dumps({
                "past_microprices": self.past_microprices,
                "volatility_ema": self.volatility_ema,
            })
        except Exception:
            return ""

    def params_for(self, product: str) -> Dict[str, float]:
        if product in self.PRODUCT_PARAMS:
            return self.PRODUCT_PARAMS[product]
        return self.PRODUCT_PARAMS["DEFAULT_VOUCHER"]

    def best_bid_ask(self, order_depth: OrderDepth) -> Tuple[int | None, int | None]:
        best_bid = max(order_depth.buy_orders.keys()) if order_depth.buy_orders else None
        best_ask = min(order_depth.sell_orders.keys()) if order_depth.sell_orders else None
        return best_bid, best_ask

    def calculate_microprice(self, order_depth: OrderDepth) -> float | None:
        best_bid, best_ask = self.best_bid_ask(order_depth)
        if best_bid is None or best_ask is None:
            return None

        bid_vol = abs(order_depth.buy_orders[best_bid])
        ask_vol = abs(order_depth.sell_orders[best_ask])
        total_vol = bid_vol + ask_vol

        if total_vol == 0:
            return (best_bid + best_ask) / 2.0

        return (best_bid * ask_vol + best_ask * bid_vol) / total_vol

    def update_volatility(self, product: str, current_microprice: float, alpha: float, max_var: float) -> float:
        if product not in self.past_microprices:
            self.past_microprices[product] = current_microprice
            self.volatility_ema[product] = 1.0
            return 1.0

        prev_microprice = self.past_microprices[product]
        sq_change = (current_microprice - prev_microprice) ** 2

        old_var = self.volatility_ema.get(product, 1.0)
        new_var = alpha * sq_change + (1.0 - alpha) * old_var
        new_var = min(max_var, max(0.25, new_var))

        self.volatility_ema[product] = new_var
        self.past_microprices[product] = current_microprice
        return new_var

    def buy_capacity(self, state: TradingState, product: str) -> int:
        return self.POSITION_LIMITS[product] - state.position.get(product, 0)

    def sell_capacity(self, state: TradingState, product: str) -> int:
        return self.POSITION_LIMITS[product] + state.position.get(product, 0)

    def add_passive_quotes(
        self,
        product: str,
        orders: List[Order],
        bid_price: int,
        ask_price: int,
        buy_qty: int,
        sell_qty: int,
    ) -> None:
        if bid_price >= 0 and buy_qty > 0:
            orders.append(Order(product, bid_price, buy_qty))
        if ask_price >= 0 and sell_qty > 0:
            orders.append(Order(product, ask_price, -sell_qty))

    def run(self, state: TradingState) -> tuple[Dict[str, List[Order]], int, str]:
        self.load_memory(state.traderData)

        result: Dict[str, List[Order]] = {}
        conversions = 0

        for product, order_depth in state.order_depths.items():
            if product not in self.POSITION_LIMITS:
                continue

            orders: List[Order] = []
            params = self.params_for(product)

            microprice = self.calculate_microprice(order_depth)
            if microprice is None:
                result[product] = orders
                continue

            variance = self.update_volatility(
                product,
                microprice,
                alpha=float(params["alpha_vol"]),
                max_var=float(params["max_var"]),
            )

            position = state.position.get(product, 0)
            buy_cap = self.buy_capacity(state, product)
            sell_cap = self.sell_capacity(state, product)

            inventory_penalty = position * float(params["risk_aversion"]) * variance
            reservation_price = microprice - inventory_penalty

            half_spread = float(params["base_spread"]) + 0.45 * math.sqrt(variance)

            # Near the end, lean harder toward reducing inventory instead of adding risk.
            if state.timestamp > 900_000:
                reservation_price -= position * 0.08
                half_spread += 0.7

            bid_price = math.floor(reservation_price - half_spread)
            ask_price = math.ceil(reservation_price + half_spread)

            raw_size = int(float(params["size"]) / max(1.0, math.sqrt(variance) / 2.0))
            trade_size = max(1, raw_size)

            # Cross only when the book is clearly mispriced versus reservation price.
            # This keeps your original profitable sniping idea, but clips by limits.
            best_bid, best_ask = self.best_bid_ask(order_depth)
            bought = 0
            sold = 0

            take_edge = half_spread * float(params["take_mult"])

            if best_ask is not None and best_ask < reservation_price - take_edge and buy_cap > 0:
                ask_volume = abs(order_depth.sell_orders[best_ask])
                qty = min(ask_volume, trade_size, buy_cap)
                if qty > 0:
                    orders.append(Order(product, best_ask, qty))
                    bought += qty

            if best_bid is not None and best_bid > reservation_price + take_edge and sell_cap > 0:
                bid_volume = abs(order_depth.buy_orders[best_bid])
                qty = min(bid_volume, trade_size, sell_cap)
                if qty > 0:
                    orders.append(Order(product, best_bid, -qty))
                    sold += qty

            remaining_buy = max(0, buy_cap - bought)
            remaining_sell = max(0, sell_cap - sold)

            quote_buy_size = min(trade_size, remaining_buy)
            quote_sell_size = min(trade_size, remaining_sell)

            # Vouchers can have fair prices close to 0, so never quote negative bids.
            self.add_passive_quotes(
                product,
                orders,
                bid_price,
                ask_price,
                quote_buy_size,
                quote_sell_size,
            )

            result[product] = orders

        trader_data = self.save_memory()
        return result, conversions, trader_data
