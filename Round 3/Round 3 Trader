import math
import json
from typing import Dict, List, Tuple, Optional
from datamodel import OrderDepth, TradingState, Order


class Trader:
    """
    Round 3 v5: stays very close to the best v3 / original microprice bot.

    Extra optimisation versus v4:
    - tiny momentum lean, capped hard so it cannot dominate
    - endgame risk lock after ~86% of the day
    - final-phase inventory reduction after ~94% of the day
    - avoids adding inventory in the wrong direction near the end
    """

    POSITION_LIMITS = {
        "HYDROGEL_PACK": 200,
        "VELVETFRUIT_EXTRACT": 200,
        "VEV_4000": 300,
        "VEV_4500": 300,
        "VEV_5000": 300,
        "VEV_5100": 300,
        "VEV_5200": 300,
        "VEV_5300": 300,
        "VEV_5400": 300,
        "VEV_5500": 300,
        "VEV_6000": 300,
        "VEV_6500": 300,
    }

    PARAMS = {
        "HYDROGEL_PACK": {"alpha": 0.10, "risk": 0.050, "spread": 2.0, "vol_mult": 0.50, "size": 11, "edge": 0.00, "imb": 0.25},
        "VELVETFRUIT_EXTRACT": {"alpha": 0.10, "risk": 0.050, "spread": 2.0, "vol_mult": 0.50, "size": 11, "edge": 0.00, "imb": 0.30},
        "VEV_4000": {"alpha": 0.10, "risk": 0.045, "spread": 2.0, "vol_mult": 0.50, "size": 10, "edge": 0.00, "imb": 0.15},
        "VEV_4500": {"alpha": 0.10, "risk": 0.045, "spread": 2.0, "vol_mult": 0.50, "size": 10, "edge": 0.00, "imb": 0.15},
        "VEV_5000": {"alpha": 0.10, "risk": 0.050, "spread": 2.0, "vol_mult": 0.50, "size": 10, "edge": 0.00, "imb": 0.20},
        "VEV_5100": {"alpha": 0.10, "risk": 0.050, "spread": 2.0, "vol_mult": 0.50, "size": 10, "edge": 0.00, "imb": 0.20},
        "VEV_5200": {"alpha": 0.10, "risk": 0.055, "spread": 2.1, "vol_mult": 0.52, "size": 9, "edge": 0.00, "imb": 0.20},
        "VEV_5300": {"alpha": 0.10, "risk": 0.055, "spread": 2.1, "vol_mult": 0.52, "size": 9, "edge": 0.00, "imb": 0.20},
        "VEV_5400": {"alpha": 0.10, "risk": 0.060, "spread": 2.2, "vol_mult": 0.55, "size": 8, "edge": 0.00, "imb": 0.15},
        "VEV_5500": {"alpha": 0.10, "risk": 0.060, "spread": 2.2, "vol_mult": 0.55, "size": 8, "edge": 0.00, "imb": 0.15},
        "VEV_6000": {"alpha": 0.10, "risk": 0.040, "spread": 1.8, "vol_mult": 0.45, "size": 6, "edge": 0.00, "imb": 0.05},
        "VEV_6500": {"alpha": 0.10, "risk": 0.040, "spread": 1.8, "vol_mult": 0.45, "size": 6, "edge": 0.00, "imb": 0.05},
    }

    def __init__(self):
        self.past_microprices: Dict[str, float] = {}
        self.volatility_ema: Dict[str, float] = {}
        self.mid_ema: Dict[str, float] = {}
        self.last_micro_diff: Dict[str, float] = {}

    def load_state(self, trader_data: str) -> None:
        if not trader_data:
            return
        try:
            data = json.loads(trader_data)
            self.past_microprices.update({k: float(v) for k, v in data.get("past", {}).items()})
            self.volatility_ema.update({k: float(v) for k, v in data.get("var", {}).items()})
            self.mid_ema.update({k: float(v) for k, v in data.get("ema", {}).items()})
            self.last_micro_diff.update({k: float(v) for k, v in data.get("diff", {}).items()})
        except Exception:
            pass

    def save_state(self) -> str:
        try:
            return json.dumps({
                "past": self.past_microprices,
                "var": self.volatility_ema,
                "ema": self.mid_ema,
                "diff": self.last_micro_diff,
            })
        except Exception:
            return ""

    def best_bid_ask(self, order_depth: OrderDepth) -> Tuple[Optional[int], Optional[int]]:
        best_bid = max(order_depth.buy_orders.keys()) if order_depth.buy_orders else None
        best_ask = min(order_depth.sell_orders.keys()) if order_depth.sell_orders else None
        return best_bid, best_ask

    def calculate_microprice(self, order_depth: OrderDepth) -> Optional[float]:
        best_bid, best_ask = self.best_bid_ask(order_depth)
        if best_bid is None or best_ask is None:
            return None

        ask_vol = abs(order_depth.sell_orders[best_ask])
        bid_vol = abs(order_depth.buy_orders[best_bid])
        total = bid_vol + ask_vol
        if total <= 0:
            return (best_bid + best_ask) / 2.0

        return (best_bid * ask_vol + best_ask * bid_vol) / total

    def mid_price(self, order_depth: OrderDepth) -> Optional[float]:
        best_bid, best_ask = self.best_bid_ask(order_depth)
        if best_bid is None or best_ask is None:
            return None
        return (best_bid + best_ask) / 2.0

    def imbalance(self, order_depth: OrderDepth) -> float:
        best_bid, best_ask = self.best_bid_ask(order_depth)
        if best_bid is None or best_ask is None:
            return 0.0
        bid_vol = abs(order_depth.buy_orders[best_bid])
        ask_vol = abs(order_depth.sell_orders[best_ask])
        if bid_vol + ask_vol == 0:
            return 0.0
        raw = (bid_vol - ask_vol) / (bid_vol + ask_vol)
        return math.tanh(1.5 * raw)

    def update_mid_ema(self, product: str, mid: float) -> float:
        if product not in self.mid_ema:
            self.mid_ema[product] = mid
        else:
            self.mid_ema[product] = 0.04 * mid + 0.96 * self.mid_ema[product]
        return self.mid_ema[product]

    def update_volatility(self, product: str, current_microprice: float) -> float:
        p = self.PARAMS.get(product, self.PARAMS["HYDROGEL_PACK"])
        alpha = p["alpha"]

        if product not in self.past_microprices:
            self.past_microprices[product] = current_microprice
            self.volatility_ema[product] = 1.0
            self.last_micro_diff[product] = 0.0
            return 1.0

        prev_microprice = self.past_microprices[product]
        diff = current_microprice - prev_microprice
        self.last_micro_diff[product] = 0.20 * diff + 0.80 * self.last_micro_diff.get(product, 0.0)
        sq_return = diff * diff

        current_variance = self.volatility_ema.get(product, 1.0)
        new_variance = alpha * sq_return + (1.0 - alpha) * current_variance
        new_variance = max(0.25, min(new_variance, 10000.0))

        self.volatility_ema[product] = new_variance
        self.past_microprices[product] = current_microprice
        return new_variance

    def position(self, state: TradingState, product: str) -> int:
        return state.position.get(product, 0)

    def buy_capacity(self, state: TradingState, product: str) -> int:
        return self.POSITION_LIMITS.get(product, 0) - self.position(state, product)

    def sell_capacity(self, state: TradingState, product: str) -> int:
        return self.POSITION_LIMITS.get(product, 0) + self.position(state, product)

    def add_order(self, state: TradingState, orders: List[Order], product: str, price: int, quantity: int) -> None:
        if quantity == 0 or price < 0:
            return

        if quantity > 0:
            quantity = min(quantity, self.buy_capacity(state, product))
        else:
            quantity = -min(-quantity, self.sell_capacity(state, product))

        if quantity != 0:
            orders.append(Order(product, price, quantity))

    def dynamic_size(self, product: str, variance: float, position: int) -> int:
        p = self.PARAMS.get(product, self.PARAMS["HYDROGEL_PACK"])
        vol = math.sqrt(max(variance, 1.0))
        raw_size = int(p["size"] / max(1.0, vol / 1.4))

        limit = self.POSITION_LIMITS[product]
        inv_ratio = abs(position) / limit
        inv_scale = 1.0 - min(0.65, inv_ratio)

        return max(1, int(raw_size * inv_scale))

    def time_fraction(self, timestamp: int) -> float:
        if timestamp <= 100000:
            return max(0.0, min(1.0, timestamp / 100000.0))
        return max(0.0, min(1.0, timestamp / 1000000.0))

    def run(self, state: TradingState) -> Tuple[Dict[str, List[Order]], int, str]:
        self.load_state(state.traderData)

        result: Dict[str, List[Order]] = {}
        conversions = 0
        day_frac = self.time_fraction(state.timestamp)
        endgame = day_frac > 0.84
        profit_lock = day_frac > 0.90
        final_phase = day_frac > 0.92

        for product in state.order_depths:
            if product not in self.POSITION_LIMITS:
                continue

            order_depth: OrderDepth = state.order_depths[product]
            orders: List[Order] = []

            microprice = self.calculate_microprice(order_depth)
            mid = self.mid_price(order_depth)
            if microprice is None or mid is None:
                result[product] = orders
                continue

            params = self.PARAMS.get(product, self.PARAMS["HYDROGEL_PACK"])
            variance = self.update_volatility(product, microprice)
            vol = math.sqrt(max(variance, 0.25))

            current_position = self.position(state, product)
            limit = self.POSITION_LIMITS[product]
            inv_ratio = current_position / limit

            ema = self.update_mid_ema(product, mid)
            imb = self.imbalance(order_depth)
            momentum = self.last_micro_diff.get(product, 0.0)
            momentum_lean = max(-1.5, min(1.5, 0.12 * momentum))

            fair_micro = 0.91 * microprice + 0.09 * ema + params["imb"] * imb + momentum_lean

            risk_mult = 1.0
            if endgame:
                risk_mult = 1.35
            if profit_lock:
                risk_mult = 1.75
            if final_phase:
                risk_mult = 2.35

            inventory_penalty = current_position * params["risk"] * variance * risk_mult
            soft_limit_skew = math.tanh(2.0 * inv_ratio) * (1.0 + 0.15 * vol) * risk_mult
            reservation_price = fair_micro - inventory_penalty - soft_limit_skew

            dynamic_half_spread = params["spread"] + params["vol_mult"] * vol
            if endgame:
                dynamic_half_spread *= 1.12
            if profit_lock:
                dynamic_half_spread *= 1.22
            if final_phase:
                dynamic_half_spread *= 1.45
            dynamic_half_spread = max(1.0, min(dynamic_half_spread, 24.0))

            optimal_bid = math.floor(reservation_price - dynamic_half_spread)
            optimal_ask = math.ceil(reservation_price + dynamic_half_spread)

            trade_size = self.dynamic_size(product, variance, current_position)
            if endgame:
                trade_size = max(1, int(trade_size * 0.80))
            if profit_lock:
                trade_size = max(1, int(trade_size * 0.65))
            if final_phase:
                trade_size = max(1, int(trade_size * 0.45))

            allow_buy_quote = inv_ratio < 0.85 and not (profit_lock and current_position > 0) and not (final_phase and current_position > -limit * 0.05)
            allow_sell_quote = inv_ratio > -0.85 and not (profit_lock and current_position < 0) and not (final_phase and current_position < limit * 0.05)

            if allow_buy_quote:
                self.add_order(state, orders, product, optimal_bid, trade_size)
            if allow_sell_quote:
                self.add_order(state, orders, product, optimal_ask, -trade_size)

            best_bid, best_ask = self.best_bid_ask(order_depth)
            edge = params["edge"]

            if best_ask is not None and best_ask < reservation_price - dynamic_half_spread - edge:
                if not (profit_lock and current_position >= 0):
                    take_vol = min(abs(order_depth.sell_orders[best_ask]), trade_size)
                    self.add_order(state, orders, product, best_ask, take_vol)

            if best_bid is not None and best_bid > reservation_price + dynamic_half_spread + edge:
                if not (profit_lock and current_position <= 0):
                    take_vol = min(abs(order_depth.buy_orders[best_bid]), trade_size)
                    self.add_order(state, orders, product, best_bid, -take_vol)

            if profit_lock and abs(current_position) > max(4, int(0.04 * limit)):
                divisor = 2 if final_phase else 3
                reduce_size = max(1, min(abs(current_position) // divisor, trade_size * 4))
                if current_position > 0 and best_bid is not None:
                    self.add_order(state, orders, product, best_bid, -reduce_size)
                elif current_position < 0 and best_ask is not None:
                    self.add_order(state, orders, product, best_ask, reduce_size)

            result[product] = orders

        trader_data = self.save_state()
        return result, conversions, trader_data
